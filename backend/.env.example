# CRM 系统环境变量配置

# 服务器端口
PORT=3001

# 监听地址
# 生产环境务必保持 127.0.0.1，公网入口统一走 auth-proxy（Basic Auth）。
# 若改成 0.0.0.0，等于把无保护的 3001 端口直接暴露到公网。
HOST=127.0.0.1

# JWT 密钥（必填，无默认值）
# 生成方式：openssl rand -base64 48
# 留空时后端会直接退出启动，不会退回弱默认值。
JWT_SECRET=

# auth-proxy → backend 的内部共享密钥（必填）
# 作用：后端据此确认请求来自本机代理，阻断绕过代理的直连访问。
# 生成方式：openssl rand -base64 48 > /home/admin/.openclaw/keys/internal-api.key
INTERNAL_API_SECRET=

# 数据库路径（可选，默认在 backend/crm.db）
# DB_PATH=/path/to/crm.db
